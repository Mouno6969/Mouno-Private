# Mouno frontend environment variables (Vite).
#
# Renamed from CRA's REACT_APP_* prefix to Vite's VITE_* prefix during the
# Vite migration. Copy this file to `.env.local` and fill in values as needed.

# Base URL of the Flask API.
#  - Leave EMPTY in development: the Vite dev server proxies /api to Flask
#    (see vite.config.ts -> server.proxy and VITE_DEV_API_PROXY).
#  - In production the SPA is served from the same origin as the API, so an
#    empty value (relative URLs) also works; set it only for split deployments.
VITE_API_URL=

# Where the Vite dev server proxies /api and /socket.io during `npm run dev`.
# Defaults to http://localhost:5001 (the Flask dev server) if unset.
VITE_DEV_API_PROXY=http://localhost:5001

# Toggles the "Demo data" badge on the dashboard live activity feed.
VITE_DEMO_MODE=false

# Telegram bot username used for deep links (without the @).
VITE_BOT_USERNAME=Automatedcryptobuybot
